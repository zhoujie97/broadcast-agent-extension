{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "播客智能阅读助手",
  "version": "0.23.3",
  "description": "以可拖动、可调宽度的网页悬浮阅读面板读取 Bilibili 智能稿本，并提供内容地图、高光切片、内容重构、知识笔记和延伸探索。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://www.wikidata.org/*",
    "https://zh.wikipedia.org/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开播客智能阅读助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
