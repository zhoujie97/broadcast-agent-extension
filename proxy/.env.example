ZHIPU_API_KEY=replace-with-your-zhipu-api-key
HOST=127.0.0.1
PORT=8787
AI_PROVIDER=zhipu
AI_MODEL=glm-4.7-flash
AI_FALLBACK_MODEL=
SESSION_SIGNING_SECRET=replace-with-at-least-24-random-characters
# Prefer exact published IDs. During side-load testing, chrome-extension://*
# permits any syntactically valid Chrome/Edge extension Origin.
ALLOWED_EXTENSION_ORIGINS=
RATE_LIMIT_PER_MINUTE=8
DAILY_INSTALLATION_UNITS=80
GLOBAL_DAILY_UNITS=5000
REQUEST_TIMEOUT_MS=90000
